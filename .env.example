# KidTune Configuration
PORT=8484
# Set to your server's LAN IP so Google Home speakers can stream TTS announcements
PUBLIC_BASE_URL=http://192.168.1.50:8484

# Host folder mounted to /music in Docker (point Plex to this folder for a Kids Music library)
PLEX_MUSIC_PATH=./music

# Initial Parent Mode PIN (change immediately in Parent Settings!)
PARENT_PIN=1234

# Safety Policy: hybrid | strict | auto_clean
POLICY_MODE=hybrid
PREFER_CLEAN_EDITS=true
AUTO_SUBSTITUTE_CLEAN_EDIT=false
MAX_TRACK_DURATION_SEC=600
MAX_DURATION_DIFF_SEC=20

# Plex Media Server integration (also configurable in Parent Settings UI)
PLEX_URL=http://192.168.1.50:32400
PLEX_TOKEN=
PLEX_MUSIC_SECTION_ID=
# Optional: set if KidTune's /music maps to a different path inside Plex (e.g. /data/kids-music)
PLEX_LIBRARY_PATH_PREFIX=

# Google Home via Google Keep list polling (optional)
GOOGLE_KEEP_ENABLED=false
GOOGLE_KEEP_EMAIL=
GOOGLE_KEEP_MASTER_TOKEN=
GOOGLE_KEEP_LIST_NAME=Music Requests
GOOGLE_KEEP_POLL_SECONDS=45

# Google Home Cast TTS announcements (optional; requires LAN access / host networking on Linux)
GOOGLE_CAST_ENABLED=false
GOOGLE_CAST_DEVICES=
